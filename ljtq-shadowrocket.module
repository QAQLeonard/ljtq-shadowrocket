#!name=莉景天气 v0（测试中）
#!desc=主页会员显示兼容；覆盖已识别的天气页面 API 和图片目录。授权 Token 仅在本地配置。
#!author=QAQLeonard

[MITM]
hostname = %APPEND% ljw.antforecast.com, ljwapi.baichuan.tech, navi.antforecast.com

[Script]
莉景天气授权请求 = type=http-request,pattern=^https://(?:ljw\.antforecast\.com/(?:ALLMenu|StarIndex|Relative|SunsetGlow|MorningGlow|Picture|Rainbstsm|SeaOfClouds|Rime|rime|NewAPI)/|ljwapi\.baichuan\.tech/(?:VIP/|User/|Login/|Ephemeris/GetEphemeris)|navi\.antforecast\.com/AppTokenApi/),requires-body=0,script-path=https://raw.githubusercontent.com/QAQLeonard/ljtq-shadowrocket/main/ljtq-shadowrocket-request.js?v=7,timeout=10
莉景天气会员及预测诊断 = type=http-response,pattern=^https://(?:ljwapi\.baichuan\.tech/|navi\.antforecast\.com/AppTokenApi/|ljw\.antforecast\.com/(?:ALLMenu|StarIndex|Relative|SunsetGlow|MorningGlow|Picture|Rainbstsm|SeaOfClouds|Rime|rime|NewAPI|APPMap)/),requires-body=1,script-path=https://raw.githubusercontent.com/QAQLeonard/ljtq-shadowrocket/main/ljtq-shadowrocket-diagnostics.js?v=7,timeout=10
